APP_NAME=go-foundation
APP_ENV=development
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
DOCS_ENABLED=true
METRICS_ADDR=:9090
DATABASE_URL=postgres://grpc:grpc@localhost:5432/go_foundation?sslmode=disable
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2
SHUTDOWN_TIMEOUT=10s

AUTH_LOCAL_ENABLED=true
JWT_ISSUER=go-foundation
JWT_AUDIENCE=grpc-api
JWT_ACCESS_TOKEN_TTL=15m
JWT_PRIVATE_KEY_FILE=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_FILE=./secrets/jwt_public.pem

OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
